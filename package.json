{
  "name": "taumata-arowai-water-gis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"FASTAPI,VITE\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "node scripts/run-python.js -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:node": "tsx backend/server.ts",
    "test": "node scripts/run-python.js -m pytest -v backend/tests",
    "test:backend": "node scripts/run-python.js -m pytest -v backend/tests",
    "db:info": "node scripts/run-python.js backend/manage_db.py info",
    "db:reseed": "node scripts/run-python.js backend/manage_db.py reseed",
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "start": "node scripts/run-python.js -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000",
    "preview": "npm run preview --workspace=frontend",
    "clean": "rm -rf frontend/dist dist server.js",
    "lint": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p backend/tsconfig.json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.12.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
