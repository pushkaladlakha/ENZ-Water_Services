### ==============================================================================
### TAUMATA AROWAI GIS PLATFORM - VS CODE REST CLIENT API TEST SUITE
### Extension: REST Client (humao.rest-client) in VS Code
### Click "Send Request" above any query to execute directly in VS Code!
### ==============================================================================

@baseUrl = http://127.0.0.1:8000
@contentType = application/json

### ------------------------------------------------------------------------------
### 1. HEALTH CHECKS & SYSTEM DIAGNOSTICS
### ------------------------------------------------------------------------------

# @name healthCheck
GET {{baseUrl}}/api/health HTTP/1.1

###

# @name readinessCheck
GET {{baseUrl}}/api/ready HTTP/1.1


### ------------------------------------------------------------------------------
### 2. AUTHENTICATION & ROLE-BASED ACCESS CONTROL (RBAC)
### ------------------------------------------------------------------------------

# @name citizenLogin
POST {{baseUrl}}/api/v1/auth/login HTTP/1.1
Content-Type: {{contentType}}

{
  "email": "citizen@nzwater.org.nz",
  "password": "CitizenNZ#2026"
}

###

@citizenToken = {{citizenLogin.response.body.accessToken}}

###

# @name officialLogin
POST {{baseUrl}}/api/v1/auth/login HTTP/1.1
Content-Type: {{contentType}}

{
  "email": "official@taumataarowai.govt.nz",
  "password": "OfficialWater#2026"
}

###

@officialToken = {{officialLogin.response.body.accessToken}}

###

# @name adminLogin
POST {{baseUrl}}/api/v1/auth/login HTTP/1.1
Content-Type: {{contentType}}

{
  "email": "admin@taumataarowai.govt.nz",
  "password": "ArowaiAdmin#2026"
}

###

@adminToken = {{adminLogin.response.body.accessToken}}

###

# @name getOfficialProfile
GET {{baseUrl}}/api/v1/auth/me HTTP/1.1
Authorization: Bearer {{officialToken}}


### ------------------------------------------------------------------------------
### 3. CADASTRAL ADDRESS SEARCH & PARCEL REGISTRY
### ------------------------------------------------------------------------------

# @name searchAddresses
GET {{baseUrl}}/api/v1/addresses/search?q=Great%20North%20Road&limit=5 HTTP/1.1

###

# @name getParcelById
GET {{baseUrl}}/api/v1/addresses/PARCEL-4015-GNR HTTP/1.1

###

# @name getAddressWaterSupply
GET {{baseUrl}}/api/v1/addresses/PARCEL-4015-GNR/water-supply HTTP/1.1
Authorization: Bearer {{officialToken}}


### ------------------------------------------------------------------------------
### 4. 7-STEP AUTHORITATIVE WATER SUPPLY RESOLUTION ENGINE
### ------------------------------------------------------------------------------

# @name resolveByAddress
POST {{baseUrl}}/api/v1/water-supply/resolve HTTP/1.1
Content-Type: {{contentType}}
Authorization: Bearer {{citizenToken}}

{
  "address": "4015 Great North Road, Kelston, Auckland 0602"
}

###

# @name resolveByCoordinates
POST {{baseUrl}}/api/v1/water-supply/resolve HTTP/1.1
Content-Type: {{contentType}}
Authorization: Bearer {{officialToken}}

{
  "coordinates": [-36.9094, 174.6806]
}


### ------------------------------------------------------------------------------
### 5. DRINKING WATER SUPPLY ZONES (AklDizzy) & BUFFER CORRIDORS
### ------------------------------------------------------------------------------

# @name listSupplyZones
GET {{baseUrl}}/api/v1/zones?limit=10&offset=0 HTTP/1.1

###

# @name getSupplyZoneById
GET {{baseUrl}}/api/v1/zones/AKL-SZ-14 HTTP/1.1

###

# @name getZoneBufferCorridors
GET {{baseUrl}}/api/v1/zones/AKL-SZ-14/buffers HTTP/1.1


### ------------------------------------------------------------------------------
### 6. DRINKING WATER SCHEMES & SUPPLY NETWORKS
### ------------------------------------------------------------------------------

# @name listWaterSchemes
GET {{baseUrl}}/api/v1/networks HTTP/1.1

###

# @name getWaterSchemeById
GET {{baseUrl}}/api/v1/networks/SUP-AKL-001 HTTP/1.1


### ------------------------------------------------------------------------------
### 7. RETICULATION ASSETS & RBAC TELEMETRY REDACTION
### ------------------------------------------------------------------------------

# @name listAssetsPublic
# Notice: cctvConditionScore, invertDepthM, and engineerNotes are REDACTED (null)
GET {{baseUrl}}/api/v1/assets?category=reticulation_main&limit=5 HTTP/1.1

###

# @name listAssetsOfficial
# Notice: cctvConditionScore, invertDepthM, and engineerNotes are UNREDACTED!
GET {{baseUrl}}/api/v1/assets?category=reticulation_main&limit=5 HTTP/1.1
Authorization: Bearer {{officialToken}}

###

# @name getAssetByCompkeyOfficial
GET {{baseUrl}}/api/v1/assets/2017820 HTTP/1.1
Authorization: Bearer {{officialToken}}


### ------------------------------------------------------------------------------
### 8. CITIZEN INCIDENT INTAKE & INVESTIGATION WORKFLOW
### ------------------------------------------------------------------------------

# @name submitIncidentComplaint
POST {{baseUrl}}/api/v1/incidents HTTP/1.1
Content-Type: {{contentType}}

{
  "category": "contamination_discoloration",
  "categoryLabel": "Severe Water Discoloration & Sediment",
  "severity": "high",
  "address": "4015 Great North Road, Kelston, Auckland 0602",
  "coordinates": [-36.9094, 174.6806],
  "supplyZoneId": "AKL-SZ-14",
  "supplySchemeName": "Auckland Municipal Watercare Network",
  "description": "Tap water is visibly brown with metallic sediment observed from all household cold water taps this morning.",
  "observedAt": "2026-10-13T02:30:00Z",
  "waterSupplyType": "Municipal Watercare Reticulation",
  "boilWaterAdvised": true,
  "reporterName": "Kelston Resident",
  "reporterEmail": "resident.kelston@example.nz",
  "reporterPhone": "021-555-0199",
  "isAnonymous": false
}

###

@newIncidentId = {{submitIncidentComplaint.response.body.id}}

###

# @name listIncidentComplaints
GET {{baseUrl}}/api/v1/incidents?status=Submitted HTTP/1.1

###

# @name getIncidentComplaint
GET {{baseUrl}}/api/v1/incidents/NZ-DW-2026-4821 HTTP/1.1

###

# @name updateIncidentByOfficial
# Only Authorized Officials or Administrators can update investigation status!
PATCH {{baseUrl}}/api/v1/incidents/NZ-DW-2026-4821 HTTP/1.1
Content-Type: {{contentType}}
Authorization: Bearer {{officialToken}}

{
  "status": "Under Investigation",
  "officerNotes": "Water quality sampling kit dispatched. Watercare field team notified of mains flushing required along Great North Road.",
  "boilWaterAdvised": true
}
