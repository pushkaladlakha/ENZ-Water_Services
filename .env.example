# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TAUMATA AROWAI & GIS MAP TILE CONFIGURATION
# Permanent, environment-configured map endpoints (never requested from end users in the UI)
VITE_MAP_TILES_CARTO="https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png"
VITE_MAP_TILES_OSM="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
VITE_MAP_TILES_ESRI_SATELLITE="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
VITE_MAP_TILES_LINZ_TOPO="https://basemaps.linz.govt.nz/v1/tiles/aerial/EPSG:3857/{z}/{x}/{y}.png"

# Optional LINZ Data Service browser-safe token (configured in CI/CD deployment, not via UI prompts)
VITE_LINZ_PUBLIC_API_KEY=""

# PostgreSQL / PostGIS Database Connection (Server-side deployment only; never exposed in client bundle)
DATABASE_URL="postgresql://postgres:password@localhost:5432/taumata_arowai_gis"
